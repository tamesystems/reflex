{
  "extends": "./examples.json",
  "compilerOptions": {
    "paths": {
      "react": ["../../../apps/mobile/node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["../../../apps/mobile/node_modules/@types/react/jsx-runtime.d.ts"],
      "react-dom/*": ["../../../apps/web/node_modules/@types/react-dom/*"],
      "react-native": ["../../../apps/mobile/node_modules/react-native/types_generated/index.d.ts"],
      "react-router": ["../../../apps/web/node_modules/react-router/dist/production/index.d.ts"],
      "@reflex/react": ["../../../packages/react/src/index.ts"],
      "@reflex/react/advanced": ["../../../packages/react/src/advanced.ts"],
      "@reflex/react-router": ["../../../packages/react-router/src/index.ts"],
      "expo-router": ["../../../apps/mobile/node_modules/expo-router"],
      "@react-native-async-storage/async-storage": [
        "../../../apps/mobile/node_modules/@react-native-async-storage/async-storage"
      ],
      "expo/metro-config": ["../../../apps/mobile/node_modules/expo/metro-config.d.ts"],
