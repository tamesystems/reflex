      "@reflex/effect": ["../../../packages/effect/src/index.ts"],
      "@reflex/live": ["../../../packages/live/src/index.ts"],
      "@reflex/expo/dev": ["../../../packages/expo/src/dev.ts"],
      "@reflex/react-router/advanced": ["../../../packages/react-router/src/advanced.ts"],
      "@reflex/runtime/internal": ["../../../packages/runtime/src/internal.ts"],
      "@reflex/effect/internal": ["../../../packages/effect/src/internal.ts"],
      "@reflex/effect/advanced": ["../../../packages/effect/src/advanced.ts"],
      "@reflex/live/dev": ["../../../packages/live/src/dev.ts"],
      "@reflex/test": ["../../../packages/test/src/index.ts"],
      "@reflex/test/advanced": ["../../../packages/test/src/advanced.ts"],
      "@reflex/react/internal": ["../../../packages/react/src/internal.ts"],
      "@reflex/expo/advanced": ["../../../packages/expo/src/advanced.ts"]
    }
  },
  "include": [
    "examples/examples/inventory/src/**/*.ts",
    "examples/examples/plain/src/**/*.ts",
    "examples/examples/live-counter/src/**/*.ts",
    "examples/apps/web/src/**/*.ts",
    "examples/apps/web/src/**/*.tsx",
    "../../../apps/web/src/api.types.ts",
    "../../../apps/web/src/bindings.types.tsx",
    "examples/apps/mobile/**/*.ts",
    "examples/apps/mobile/**/*.tsx",
    "../../../apps/mobile/src/api.types.ts",
    "../../../apps/mobile/src/expo.types.tsx",
    "examples/apps/mobile/**/*.js",
    "examples/examples/inventory/test/**/*.ts",
    "examples/examples/inventory/journeys/**/*.ts",
    "../../../packages/test/test/author.types.ts",
    "examples/reset.ts",
    "examples/capabilities.tsx",
    ".generated/test-plumbing.ts"
