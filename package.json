{
  "name": "reflex-effect",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun scripts/type-budget.ts && bun run --cwd apps/mobile typecheck && bun run --cwd apps/web typecheck",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check . && bun scripts/check-docs.ts && bun run typecheck && bun test",
    "bench": "bun bench/wire.ts",
    "reflex": "bun packages/cli/src/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@reflex/effect": "workspace:*",
    "@reflex/live": "workspace:*",
    "@reflex/protocol": "workspace:*",
    "@reflex/rpc": "workspace:*",
    "@reflex/runtime": "workspace:*",
    "@reflex/test": "workspace:*",
    "@types/bun": "1.4.4",
    "ajv": "8.20.0",
    "effect": "4.1.2",
    "typescript": "5.9.3",
    "xstate": "5.33.4",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "packageManager": "bun@1.4.4"
}
