{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "examples/*/src",
    "examples/*/test",
    "test",
    "bench",
    "experiments"
  ],
  "exclude": [
    "packages/expo/src/react.tsx",
    "packages/expo/src/effect.tsx",
    "packages/react/src/react.tsx",
    "packages/react/src/effect.tsx",
    "packages/react-router/src/index.ts"
  ]
}
