{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node", "bun"],
    "paths": {
      "@reflex/protocol": ["../../packages/protocol/src/index.ts"],
      "@reflex/runtime": ["../../packages/runtime/src/index.ts"],
      "@reflex/rpc/connection": ["../../packages/rpc/src/server.ts"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime.d.ts"],
      "@reflex/live": ["../../packages/live/src/index.ts"],
      "@reflex/react": ["../../packages/react/src/index.ts"],
      "@reflex/live/session": ["../../packages/live/src/session.ts"],
      "@reflex/react-router": ["../../packages/react-router/src/index.ts"],
      "react-router": ["./node_modules/react-router"],
      "react-dom/client": ["./node_modules/@types/react-dom/client.d.ts"],
      "@reflex/live/vite": ["../../packages/live/src/vite.ts"],
      "@reflex/react/advanced": ["../../packages/react/src/advanced.ts"],
      "@reflex/effect/internal": ["../../packages/effect/src/internal.ts"],
      "@reflex/runtime/internal": ["../../packages/runtime/src/internal.ts"],
      "@reflex/effect/advanced": ["../../packages/effect/src/advanced.ts"],
      "@reflex/react-router/advanced": ["../../packages/react-router/src/advanced.ts"],
      "@reflex/react/internal": ["../../packages/react/src/internal.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "../../packages/react-router/src", "e2e"]
}
